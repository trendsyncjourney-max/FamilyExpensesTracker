# Hearth — environment configuration template.
# Copy to `.env` and fill in real values:  cp .env.example .env
# Never commit `.env`. Only VITE_* variables are exposed to the browser.

# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID (must match the OAuth app below)
APP_SECRET=               # Random secret used to sign session JWTs (e.g. `openssl rand -hex 32`)

# ── Database ───────────────────────────────────────────────────
# MySQL 8 connection string. Example: mysql://hearth:hearth@localhost:3306/hearth
DATABASE_URL=

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID (same value as APP_ID)

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (server-side; usually same as VITE_KIMI_AUTH_URL)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login
